# Clean Water — muhit o'zgaruvchilari namunasi.
#
# ISHLATISH: bu faylni `.env` ga nusxalang va haqiqiy qiymatlarni yozing:
#     cp env.example .env
#
# §6: sirlar hech qachon repozitoriyga tushmaydi. `.env` .gitignore da.

# ── Ma'lumotlar bazasi ───────────────────────────────────────────────────────
# Lokal ishlab chiqish (docker compose up -d postgres):
DATABASE_URL="postgresql://cleanwater:cleanwater@localhost:5432/cleanwater?schema=public"
# Docker ichida `web` va `worker` uchun host `postgres` bo'ladi:
# DATABASE_URL="postgresql://cleanwater:cleanwater@postgres:5432/cleanwater?schema=public"

POSTGRES_USER=cleanwater
POSTGRES_PASSWORD=cleanwater
POSTGRES_DB=cleanwater

# ── Telegram ─────────────────────────────────────────────────────────────────
# @BotFather bergan token. initData HMAC imzosi shu bilan tekshiriladi (§4.4).
TELEGRAM_BOT_TOKEN=""
# Login Widget uchun bot username (@ belgisisiz).
TELEGRAM_BOT_USERNAME=""
# Bootstrap adminlar — vergul bilan ajratilgan Telegram ID lar (§4.4).
TELEGRAM_ADMIN_IDS=""
# Arizalar tushadigan menejerlar guruhi (§4.5).
TELEGRAM_MANAGER_CHAT_ID=""
# Webhook ni tasdiqlash uchun maxfiy token. Yaratish: openssl rand -hex 32
# BO'SH QOLDIRILSA webhook umuman ishlamaydi (barcha so'rov 401) — bu ataylab:
# sirsiz webhook istalgan odam uchun ochiq ariza generatori bo'lardi (§6).
# Telegramga ulash:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://<domen>/telegram/webhook" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>" \
#     -d 'allowed_updates=["callback_query","message"]'
TELEGRAM_WEBHOOK_SECRET=""

# Eslatmalarni tashqaridan ishga tushirish uchun sir (§4.6).
# Yaratish: openssl rand -hex 32
# BO'SH QOLDIRILSA `POST /jobs/reminders` hamma so'rovni 401 qiladi.
# Bepul hostingda (Render) jarayon bekorchilikdan keyin uxlaydi va ichidagi
# kunlik taymer ishlamaydi — tashqi cron xizmati (cron-job.org) shu manzilga
# har kuni 04:00 UTC (Toshkent 09:00) da so'rov yuboradi:
#   curl -X POST https://<worker>/jobs/reminders #     -H "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# ── Sessiya ──────────────────────────────────────────────────────────────────
# JWT imzo kaliti. Yaratish: openssl rand -base64 48
JWT_SECRET=""

# ── Ilova ────────────────────────────────────────────────────────────────────
# Kanonik havolalar va hreflang shu manzildan quriladi (§4.7).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Eslatmalar 09:00 da shu mintaqa bo'yicha yuboriladi (§4.6). Hisobning o'zi
# TZ ga bog'liq emas — worker Toshkent siljishini kodda ushlab turadi.
TZ="Asia/Tashkent"
# `worker` konteynerida webhook tinglaydigan port (nginx shu yerga uzatadi).
WORKER_PORT=8081

# ── Ishlash va zaxira (ixtiyoriy) ────────────────────────────────────────────
# Bitta jarayonning ulanishlar hovuzi. Bazadagi `max_connections` shu
# qiymatga instanslar soniga ko'paytirilgandan katta bo'lishi kerak,
# aks holda sahifalar «Too many database connections» bilan 500 qaytaradi.
DATABASE_POOL_MAX=10
# Kunlik zaxira vaqti (konteyner TZ si bo'yicha) va saqlash muddati.
BACKUP_HOUR=03
BACKUP_RETENTION_DAYS=14
